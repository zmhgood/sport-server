# 服务配置
server:
  port: 8080
  read_timeout: 10s
  write_timeout: 10s

# 数据库配置
database:
  host: 127.0.0.1
  port: 3306
  user: root
  password: your_password
  dbname: elderly_fitness

# Redis配置
redis:
  host: localhost
  port: 6379
  password: ""
  db: 0

# JWT配置
jwt:
  secret: your-jwt-secret-key-change-this-in-production
  expire_time: 168h  # 7天

# 微信小程序配置
wechat:
  app_id: your_app_id
  app_secret: your_app_secret
